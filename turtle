import turtle as t
from turtle import *

t.pen(fillcolor="red", pencolor='orange', pensize=5)
t.begin_fill()
forward(300)
left(150)
forward(200)
left(68)
forward(163)
t.end_fill()
left(142)
right(10)
forward(250)
backward(250)
right(50)

x = 5

while x > 0:
    t.begin_fill()
    forward(300)
    left(150)
    forward(200)
    left(68)
    forward(163)
    t.end_fill()
    left(142)
    right(10)
    forward(250)
    backward(250)
    right(50)
    x = x-1
    